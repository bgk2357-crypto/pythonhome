# Copy to .env locally / on PythonAnywhere. Never commit the real .env.
APP_ORIGIN=http://127.0.0.1:5000
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=
# A private directory OUTSIDE public/. Use an absolute path in production.
DATA_DIR=.data
MASTER_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_MAP_CLIENT_ID=
# Optional password reset delivery; keep blank until configured and verified.
MAIL_TRANSPORT=
MAIL_FROM=
MAIL_API_URL=https://api.resend.com/emails
MAIL_API_KEY=
